# ==========================================
# SafeTrade Backend - Render / Production & Dev Environment
# ==========================================

# 1. Database Connection (PostgreSQL on Render / ElephantSQL / AWS RDS)
SPRING_DATASOURCE_URL=jdbc:postgresql://<RENDER_POSTGRES_HOST>:5432/<DATABASE_NAME>
SPRING_DATASOURCE_USERNAME=<DB_USERNAME>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

# 2. JWT Authentication Secret (256-bit+ secure random secret)
JWT_SECRET=your-super-secret-key-that-needs-to-be-at-least-256-bits-long!

# 3. Paystack Payment Gateway Keys
# Obtain from Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Live Webhook URL to register in Paystack Dashboard: https://safetrade-or1w.onrender.com/api/webhooks/paystack

# 4. Brevo (Sendinblue) Email OTP Service
# Obtain from Brevo Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=noreply@safetrade.app
